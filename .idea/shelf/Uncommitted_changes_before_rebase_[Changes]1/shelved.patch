oid:name=\".RegisterActivity\"\r\n            android:exported=\"false\" />\r\n\r\n        <!-- 编辑档案页面 -->\r\n        <activity\r\n            android:name=\".EditPetActivity\"\r\n            android:exported=\"false\"\r\n            android:parentActivityName=\".MainActivity\" />\r\n\r\n        <!-- 新增记录页面 -->\r\n        <activity\r\n            android:name=\".AddRecordActivity\"\r\n            android:exported=\"false\"\r\n            android:parentActivityName=\".MainActivity\" />\r\n\r\n        <!-- 注意：AI分析页面现在通过Fragment在MainActivity中显示 -->\r\n        <!-- 不需要单独的Activity声明 -->\r\n\r\n    </application>\r\n\r\n</manifest>
